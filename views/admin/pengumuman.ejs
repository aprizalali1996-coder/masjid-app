<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color: #164230;">Pusat Siaran Pengumuman</h4>
    <button class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm" style="color: #5c3a00;" data-bs-toggle="modal" data-bs-target="#modalTambahPengumuman">
        <i class="bi bi-megaphone-fill"></i> Buat Pengumuman Baru
    </button>
</div>

<div class="modern-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="bg-light">
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">Informasi Pengumuman</th>
                    <th>Status</th>
                    <th class="text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(data && data.length > 0) { %>
                    <% data.forEach(p => { %>
                    <tr style="border-bottom: 1px solid #f8f9fa;">
                        <td class="ps-4 py-3" style="max-width: 400px;">
                            <div class="d-flex align-items-center mb-1">
                                <h6 class="fw-bold mb-0 me-2 text-dark"><%= p.judul %></h6>
                                <small class="text-muted">(<%= p.tanggal %>)</small>
                            </div>
                            <p class="text-muted small mb-0 text-truncate"><%= p.isi %></p>
                        </td>
                        <td>
                            <% if(p.status === 'Aktif') { %>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 border border-primary border-opacity-25">Sedang Tayang</span>
                            <% } else { %>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary border-opacity-25">Disembunyikan</span>
                            <% } %>
                        </td>
                        <td class="text-center">
                            <a href="/admin/pengumuman/delete/<%= p.id %>" class="btn btn-sm btn-outline-danger border-0 rounded-circle" onclick="return confirm('Hapus pengumuman ini?')">
                                <i class="bi bi-trash3 fs-5"></i>
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">Belum ada pengumuman yang dibuat.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalTambahPengumuman" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 30px;">
            <div class="modal-body p-5">
                <h4 class="fw-bold mb-4" style="color: #164230;">Buat Pengumuman Baru</h4>
                <form action="/admin/pengumuman/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Judul Pengumuman</label>
                        <input type="text" name="judul" class="form-control rounded-4 p-3" placeholder="Contoh: Gotong Royong Masjid" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Isi Pesan</label>
                        <textarea name="isi" class="form-control rounded-4 p-3" rows="4" placeholder="Tuliskan detail pengumuman di sini..." required></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Status Penayangan</label>
                        <select name="status" class="form-select rounded-4 p-3">
                            <option value="Aktif">Aktif (Tampilkan di Web Publik)</option>
                            <option value="Nonaktif">Nonaktif (Simpan sebagai Draft)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-warning fw-bold py-3 w-100 rounded-4" style="color: #5c3a00;">Siarkan Pengumuman</button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>