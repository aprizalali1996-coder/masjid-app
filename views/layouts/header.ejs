<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Masjid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #F8F9FA; /* Abu-abu/Cream sangat lembut */
            color: #2D3748; 
        }
        
        /* SIDEBAR MODERN (Melayang & Rounded) */
        .sidebar-wrapper { padding: 20px 0 20px 20px; }
        .sidebar {
            background-color: #164230; /* Hijau Gelap Elegan */
            border-radius: 30px;
            min-height: calc(100vh - 40px);
            padding: 30px 20px;
            box-shadow: 10px 10px 30px rgba(22, 66, 48, 0.1);
        }
        .sidebar-brand { 
            color: white; font-weight: 800; font-size: 1.25rem; 
            margin-bottom: 40px; display: flex; align-items: center; gap: 10px;
            text-decoration: none; 
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.7);
            border-radius: 16px;
            padding: 14px 20px;
            margin-bottom: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .sidebar .nav-link i { margin-right: 12px; font-size: 1.2rem; vertical-align: middle;}
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: #FDFBF7; /* Latar Cream saat aktif */
            color: #164230; /* Teks Hijau Gelap */
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        /* MAIN CONTENT AREA */
        .main-content { padding: 30px 40px; width: 100%; overflow-y: auto; height: 100vh; }
        
        /* TOPBAR (Pencarian & Profil) */
        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
        .search-wrapper {
            background: white; border-radius: 20px; padding: 12px 25px; 
            width: 350px; display: flex; align-items: center; gap: 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }
        .search-wrapper input { border: none; outline: none; width: 100%; background: transparent; }
        .admin-profile { display: flex; align-items: center; gap: 15px; }
        .admin-profile img { width: 50px; height: 50px; border-radius: 50%; border: 3px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1);}
        
        /* MODERN CARDS */
        .modern-card { 
            background: white; border-radius: 28px; border: none; 
            padding: 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.03); 
        }
        .stat-value { font-size: 2.2rem; font-weight: 800; color: #164230; letter-spacing: -1px;}
        .stat-label { color: #718096; font-size: 0.95rem; font-weight: 600; margin-bottom: 5px; }
        .trend-badge { font-size: 0.85rem; font-weight: 700; padding: 6px 12px; border-radius: 12px; display: inline-block;}
        .trend-up { color: #238636; background: #DAFBE4; }
    </style>
</head>
<body>
<div class="d-flex">